# The e2e environment, versioned, read by apps/app-api/vitest.config.e2e.ts. apps/app-api/test/setup-e2e.ts uses
# this URL only to create and drop each file's database on this Postgres server. A variable of the environment
# (the CI) wins over this file.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/__PROJECT__
