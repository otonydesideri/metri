{
	"name": "@metri/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./postgres": "./src/postgres/index.ts"
	},
	"scripts": {
		"postinstall": "prisma generate --config src/postgres/prisma.config.ts",
		"generate": "prisma generate --config src/postgres/prisma.config.ts",
		"migrate:dev": "prisma migrate dev --config src/postgres/prisma.config.ts",
		"migrate:deploy": "prisma migrate deploy --config src/postgres/prisma.config.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "vitest run"
	},
	"dependencies": {
		"@prisma/client": "7.10.0"
	},
	"devDependencies": {
		"@types/node": "22.20.4",
		"dotenv": "18.0.5",
		"prisma": "7.10.0"
	}
}
